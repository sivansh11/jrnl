#!/usr/bin/env python3

import argparse
import datetime
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import openai

JRNL_DEBUG = os.environ.get('JRNL_DEBUG', False)
JRNL_FOLDER = Path(os.environ.get('JRNL_FOLDER', '~/.jrnl')).expanduser()
JRNL_BASE_URL = os.environ.get('JRNL_BASE_URL', 'http://localhost:8080/v1')
JRNL_API_KEY = os.environ.get('JRNL_API_KEY', 'api-key')
JRNL_EXTRACTION_MODEL = os.environ.get('JRNL_EXTRACTION_MODEL', 'unsloth/gemma-4-E2B-it-qat-GGUF:Q4_K_XL')
JRNL_CHAT_MODEL = os.environ.get('JRNL_CHAT_MODEL', JRNL_EXTRACTION_MODEL)
JRNL_EMBEDDING_MODEL = os.environ.get('JRNL_EMBEDDING_MODEL', 'nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0')
JRNL_EMBEDDING_BASE_URL = os.environ.get('JRNL_EMBEDDING_BASE_URL', JRNL_BASE_URL)
JRNL_EMBEDDING_API_KEY = os.environ.get('JRNL_EMBEDDING_API_KEY', JRNL_API_KEY)
CONFIG_PATH = JRNL_FOLDER / 'in-use.config'
CHAT_SYSTEM_PROMPT = """You are a helpful assistant with the access to the user's personal journal entries.
RULES:
1) Answer the user's question based only on the provided journal context.
2) The context is a list of journal chunks, each prefixed with its source timestamp, chunk id, and similarity score in square brackets. For example: [01-08-2026--04-59-58 #3 0.85].
    While answering using a chunk as a reference, add citations of the source by listing the timestamp and chunk id, for example, [01-08-2026--04-59-58 #3, 02-08-2026--10-00-00 #7].
3) If no chunk is relevant, or no chunks are provided, say you dont know!."""
CHUNK_SYSTEM_PROMPT = """You are a text processing engine designed for a memory retrieval system. Your task is to extract "Semantically Atomic" chunks (which can be events, thoughts, emotions, or observations) from raw journal entries.
CRITICAL DEFINITION - SEMANTIC ATOMICITY:
A chunk must be the smallest possible unit of information that remains FULLY SELF-CONTAINED.
TRANSFORMATION RULES:
1. SPLIT ON SHIFTS (Highest Priority): Create a new chunk if the user changes physical locations, distinct time blocks, or abruptly changes topics/train of thought.
2. MERGE TIGHTLY BOUND IDEAS/ACTIONS: Only merge actions or sentences if they describe the exact same continuous event or belong to the exact same continuous thought.
3. PRESERVE INTERNAL STATE: Emotions, opinions, and philosophical statements (e.g., "I hate that things don't work") are highly valuable. NEVER treat them as empty/junk inputs.
4. OUTPUT FORMAT: Keep your internal reasoning extremely brief (1-2 short sentences max). Output a single JSON array of strings. Return [] ONLY if the input is absolute unreadable gibberish."""
EXTRA_BODY = {
    'enable_thinking': True
}

TIMESTAMP_RE = re.compile(r'(\d{2}-\d{2}-\d{4}--\d{2}-\d{2}-\d{2})')

_client: openai.OpenAI | None = None
_embedding_client: openai.OpenAI | None = None


def get_client() -> openai.OpenAI:
    global _client
    if _client is None:
        _client = openai.OpenAI(base_url=JRNL_BASE_URL, api_key=JRNL_API_KEY)
    return _client


def get_embedding_client() -> openai.OpenAI:
    global _embedding_client
    if _embedding_client is None:
        _embedding_client = openai.OpenAI(base_url=JRNL_EMBEDDING_BASE_URL, api_key=JRNL_EMBEDDING_API_KEY)
    return _embedding_client


def add(entry: str) -> None:
    j = {'entry': entry}
    base = datetime.datetime.now().strftime('%d-%m-%Y--%H-%M-%S')
    name = f'{base}.json.pending'
    n = 1
    while (JRNL_FOLDER / name).exists():
        name = f'{base}-{n}.json.pending'
        n += 1
    write_json_atomic(JRNL_FOLDER / name, j)
    if JRNL_DEBUG:
        print(f'[{name}]')
        print(j)


def llm(system_prompt: str, prompt: str, model: str) -> openai.ChatCompletionMessage:
    messages: list[openai.ChatCompletionMessageParam] = [
        {'role': 'system', 'content': system_prompt},
        {'role': 'user', 'content': prompt},
    ]
    try:
        response = get_client().chat.completions.create(
            model=model,
            messages=messages,
            extra_body=EXTRA_BODY,
        )
    except openai.APIConnectionError as e:
        print(f'couldnt connect aborting: {e}', file=sys.stderr)
        sys.exit(1)
    return response.choices[0].message


def embed(text: str, model: str) -> list[float]:
    try:
        response = get_embedding_client().embeddings.create(model=model, input=text)
    except openai.APIConnectionError as e:
        print(f'couldnt connect aborting: {e}', file=sys.stderr)
        sys.exit(1)
    return response.data[0].embedding


def get_reasoning(message: openai.ChatCompletionMessage) -> str | None:
    reasoning = getattr(message, 'reasoning_content', None)
    if reasoning:
        return reasoning
    reasoning = getattr(message, 'reasoning', None)
    if reasoning:
        return reasoning
    details = getattr(message, 'reasoning_details', None)
    if details:
        texts = []
        for d in details:
            text = d.get('text') if isinstance(d, dict) else getattr(d, 'text', None)
            if text:
                texts.append(text)
        return '\n'.join(texts)
    return None


def write_json_atomic(path: Path, data: object) -> None:
    fd, tmp = tempfile.mkstemp(dir=JRNL_FOLDER, prefix='.tmp-', suffix='.json')
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_embedding_config() -> tuple[str, int] | None:
    if not CONFIG_PATH.exists():
        return None
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return data['embeddings_model'], data['embeddings_dim']
    except (json.JSONDecodeError, KeyError, TypeError) as e:
        print(f'invalid embeddings config: {e}', file=sys.stderr)
        sys.exit(1)


def save_embedding_config(model: str, dim: int) -> None:
    write_json_atomic(CONFIG_PATH, {'embeddings_model': model, 'embeddings_dim': dim})


def extract_chunks(content: str) -> list[str]:
    text = re.sub(r'^```(?:json)?\s*|\s*```$', '', content.strip())
    match = re.search(r'\[.*\]', text, re.DOTALL)
    if not match:
        raise ValueError(f'no json array found in llm message content: {text}')
    try:
        chunks = json.loads(match.group(0))
    except json.JSONDecodeError as e:
        raise ValueError(f'invalid json parsed: {match.group(0)!r}') from e
    if not isinstance(chunks, list) or not all(isinstance(c, str) for c in chunks):
        raise ValueError(f'expected a list of strings, got: {match.group(0)!r}')
    return chunks


def sync_entry(path: Path, embeddings: dict[str, list[float]]) -> None:
    j = json.loads(path.read_text())
    entry = j['entry']
    if JRNL_DEBUG:
        print(f'[{path.name}]')
        print(j)
    message = llm(CHUNK_SYSTEM_PROMPT, entry, JRNL_EXTRACTION_MODEL)
    if not message.content:
        raise ValueError('llm didnt return message content')
    if JRNL_DEBUG:
        reasoning = get_reasoning(message)
        if reasoning:
            print(reasoning)
        print(message.content)
    chunks = extract_chunks(message.content)
    out = {'entry': entry, 'chunks': []}
    next_id = max((int(k) for k in embeddings), default=-1) + 1
    for chunk in chunks:
        chunk_id = str(next_id)
        next_id += 1
        embeddings[chunk_id] = embed(f"search_document: {chunk}", JRNL_EMBEDDING_MODEL)
        out['chunks'].append({'id': chunk_id, 'chunk': chunk})
    write_json_atomic(JRNL_FOLDER / 'embeddings.json', embeddings)
    if embeddings:
        save_embedding_config(JRNL_EMBEDDING_MODEL, len(next(iter(embeddings.values()))))
    write_json_atomic(path.with_suffix(''), out)
    path.unlink()


def sync() -> None:
    with open(JRNL_FOLDER / '.sync.lock', 'w') as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print('sync already running, exiting', file=sys.stderr)
            return

        embeddings_path = JRNL_FOLDER / 'embeddings.json'
        embeddings = {}
        if embeddings_path.exists():
            embeddings = json.loads(embeddings_path.read_text())
        config = load_embedding_config()
        if config is not None:
            stored_model, _ = config
            if stored_model != JRNL_EMBEDDING_MODEL:
                print(f'embeddings model changed from {stored_model} to {JRNL_EMBEDDING_MODEL}; run jrnl reembed', file=sys.stderr)
                sys.exit(1)
        elif embeddings:
            print('no embeddings config found; run jrnl reembed', file=sys.stderr)
            sys.exit(1)

        pending = sorted(JRNL_FOLDER.glob('*.json.pending'))
        for path in pending:
            try:
                sync_entry(path, embeddings)
            except Exception as e:
                print(f'[sync] failed {path.name}: {e}', file=sys.stderr)
            else:
                print(f'[sync] done {path.name}')


def reembed() -> None:
    with open(JRNL_FOLDER / '.sync.lock', 'w') as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print('sync already running, exiting', file=sys.stderr)
            return

        embeddings = {}
        count = 0
        for path in sorted(JRNL_FOLDER.glob('*.json')):
            if path.name.startswith('.'):
                continue
            data = json.loads(path.read_text())
            for c in data.get('chunks', []):
                embeddings[c['id']] = embed(f"search_document: {c['chunk']}", JRNL_EMBEDDING_MODEL)
                count += 1
            if JRNL_DEBUG:
                print(f'[reembed] {path.name}')
        write_json_atomic(JRNL_FOLDER / 'embeddings.json', embeddings)
        if embeddings:
            save_embedding_config(JRNL_EMBEDDING_MODEL, len(next(iter(embeddings.values()))))
        print(f'[reembed] done {count} chunks')


def ls(days: int) -> None:
    now = datetime.datetime.now()
    end = now - datetime.timedelta(days=days)
    entries = []
    for path in JRNL_FOLDER.glob('*.json*'):
        if path.name.startswith('.'):
            continue
        pending = path.name.endswith('.pending')
        name = path.name.removesuffix('.pending').removesuffix('.json')
        match = TIMESTAMP_RE.match(name)
        if not match:
            continue
        dt = datetime.datetime.strptime(match.group(1), '%d-%m-%Y--%H-%M-%S')
        if end <= dt <= now:
            with open(path) as f:
                data = json.load(f)
            entries.append((dt, data['entry'], pending, data.get('chunks')))
    if not entries:
        print('no entries found')
        return
    entries.sort(key=lambda e: e[0], reverse=True)
    for dt, entry, pending, chunks in entries:
        heading = f"[{dt.strftime('%d-%m-%Y %H:%M:%S')}]"
        if pending:
            heading += ' (pending)'
        print(heading)
        print(entry)
        if JRNL_DEBUG and chunks:
            for c in chunks:
                print(f"  [{c['id']}] {c['chunk']}")


def cosine_similarity(a: list[float], b: list[float]) -> float:
    dot = sum(x * y for x, y in zip(a, b))
    mag_a = sum(x * x for x in a) ** 0.5
    mag_b = sum(y * y for y in b) ** 0.5
    if mag_a == 0 or mag_b == 0:
        return 0.0
    return dot / (mag_a * mag_b)


def ask(query: str, threshold: float, top: int) -> None:
    embeddings_path = JRNL_FOLDER / 'embeddings.json'
    if not embeddings_path.exists():
        print('no embeddings found', file=sys.stderr)
        return
    embeddings = json.loads(embeddings_path.read_text())
    config = load_embedding_config()
    if config is None:
        print('no embeddings config found; run jrnl reembed', file=sys.stderr)
        sys.exit(1)
    stored_model, stored_dim = config
    if stored_model != JRNL_EMBEDDING_MODEL:
        print(f'embeddings model changed from {stored_model} to {JRNL_EMBEDDING_MODEL}; run jrnl reembed', file=sys.stderr)
        sys.exit(1)
    query_embedding = embed(f"search_query: {query}", JRNL_EMBEDDING_MODEL)
    if len(query_embedding) != stored_dim:
        print(f'embedding dimension changed from {stored_dim} to {len(query_embedding)}; run jrnl reembed', file=sys.stderr)
        sys.exit(1)
    candidates = []
    for path in JRNL_FOLDER.glob('*.json'):
        if path.name.startswith('.'):
            continue
        data = json.loads(path.read_text())
        source = path.stem
        for c in data.get('chunks', []):
            vec = embeddings.get(c['id'])
            if vec is None:
                continue
            sim = cosine_similarity(query_embedding, vec)
            if sim >= threshold:
                candidates.append((sim, source, c['id'], c['chunk']))
    candidates.sort(key=lambda x: x[0], reverse=True)
    top_candidates = candidates[:top]
    if not top_candidates:
        print('no relevant chunks found')
        return
    context = '\n\n'.join(
        f"[{source} #{chunk_id} {sim:.3f}] {chunk}"
        for sim, source, chunk_id, chunk in top_candidates
    )
    if JRNL_DEBUG:
        print(context)
    prompt = f"Question: {query}\n\nJournal context:\n{context}"
    message = llm(CHAT_SYSTEM_PROMPT, prompt, JRNL_CHAT_MODEL)
    if JRNL_DEBUG:
        reasoning = get_reasoning(message)
        if reasoning:
            print(reasoning)
    if message.content:
        print(message.content)


def main():
    parser = argparse.ArgumentParser(prog='jrnl')
    sub = parser.add_subparsers(dest='command', title='commands')
    _ = parser.add_argument('--debug', action='store_true', help='enable debug output')

    add_parser = sub.add_parser('add', help='add jrnl entry')
    _ = add_parser.add_argument('entry', help='your jrnl entry')

    sync_parser = sub.add_parser('sync', help='sync jrnl entries')

    ls_parser = sub.add_parser('ls', help='list entries')
    _ = ls_parser.add_argument('--days', type=int, default=3, help='entries from the last n days')

    ask_parser = sub.add_parser('ask', help='ask a question against your journal')
    _ = ask_parser.add_argument('query', help='your question')
    _ = ask_parser.add_argument('--threshold', type=float, default=0.4, help='minimum similarity (default 0.4)')
    _ = ask_parser.add_argument('--top', type=int, default=5, help='top n chunks (default 5)')

    reembed_parser = sub.add_parser('reembed', help='reembed all chunks with the current embedding model')

    args = parser.parse_args()

    JRNL_FOLDER.mkdir(parents=True, exist_ok=True)

    if args.debug:
        global JRNL_DEBUG
        JRNL_DEBUG = True

    if args.command == 'add':
        add(args.entry)
        script = Path(__file__).resolve()
        cmd = [sys.executable, str(script)]
        if args.debug:
            cmd.append('--debug')
        cmd.append('sync')
        with open(JRNL_FOLDER / '.sync.log', 'a') as logf:
            subprocess.Popen(cmd,
                             stdin=subprocess.DEVNULL,
                             stdout=logf,
                             stderr=logf,
                             start_new_session=True)

    if args.command == 'sync':
        sync()

    if args.command == 'ls':
        ls(args.days)

    if args.command == 'ask':
        ask(args.query, args.threshold, args.top)

    if args.command == 'reembed':
        reembed()


if __name__ == '__main__':
    main()
