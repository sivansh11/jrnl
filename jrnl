#!/bin/python

import argparse
import fcntl
import json
import os
import re
import sys
import subprocess
import tempfile
import datetime
from pathlib import Path

import openai

JRNL_DEBUG = os.environ.get('JRNL_DEBUG', False)
JRNL_FOLDER = Path(os.environ.get('JRNL_FOLDER', '~/.jrnl')).expanduser()
JRNL_BASE_URL = os.environ.get('JRNL_BASE_URL', 'http://localhost:8080/v1')
JRNL_API_KEY = os.environ.get('JRNL_API_KEY', "api-key")
JRNL_EXTRACTION_MODEL = os.environ.get('JRNL_EXTRACTION_MODEL',  'unsloth/gemma-4-E2B-it-qat-GGUF:Q4_K_XL')
JRNL_CHAT_MODEL = os.environ.get('JRNL_CHAT_MODEL',  JRNL_EXTRACTION_MODEL)
JRNL_EMBEDDING_MODEL = os.environ.get('JRNL_EMBEDDING_MODEL',  'nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0')
CHAT_SYSTEM_PROMPT = """You are a helpful assistant with access to the user's personal journal entries. Answer the user's question based only on the provided journal context. Be concise and cite the relevant entries when you use them. The context is a list of journal chunks, each prefixed with its source timestamp in square brackets, like [01-08-2026--04-59-58]. When you use a chunk in your answer, reference its source by listing the timestamp(s), e.g. "Sources: 01-08-2026--04-59-58, 02-08-2026--10-00-00". If no chunk is relevant, say you don't know."""
CHUNK_SYSTEM_PROMPT = """You are a text processing engine designed for a memory retrieval system. Your task is to extract "Semantically Atomic" chunks (which can be events, thoughts, emotions, or observations) from raw journal entries.
CRITICAL DEFINITION - SEMANTIC ATOMICITY:
A chunk must be the smallest possible unit of information that remains FULLY SELF-CONTAINED.
TRANSFORMATION RULES:
1. SPLIT ON SHIFTS (Highest Priority): Create a new chunk if the user changes physical locations, distinct time blocks, or abruptly changes topics/train of thought.
2. MERGE TIGHTLY BOUND IDEAS/ACTIONS: Only merge actions or sentences if they describe the exact same continuous event or belong to the exact same continuous thought.
3. PRESERVE INTERNAL STATE: Emotions, opinions, and philosophical statements (e.g., "I hate that things don't work") are highly valuable. NEVER treat them as empty/junk inputs.
4. OUTPUT FORMAT: Keep your internal reasoning extremely brief (1-2 short sentences max). Output a single JSON array of strings. Return [] ONLY if the input is absolute unreadable gibberish."""
EXTRA_BODY={
    'enable_thinking': True
}


def add(entry: str) -> None:
    j = {
        'entry': entry,
    }
    name = datetime.datetime.now().strftime('%d-%m-%Y--%H-%M-%S') + '.json.pending'
    with open(JRNL_FOLDER / name, 'w') as f:
        json.dump(j, f, indent=2)
    if JRNL_DEBUG:
        print(f'[{name}]')
        print(j)


def llm(system_prompt: str, prompt: str, model: str) -> openai.ChatCompletionMessage:
    client = openai.OpenAI(base_url=JRNL_BASE_URL, api_key=JRNL_API_KEY)
    messages: list[openai.ChatCompletionMessageParam] = [{'role': 'system', 'content': system_prompt}]
    messages.append({'role': 'user', 'content': prompt})
    try:
        response = client.chat.completions.create(
            model = model,
            messages=messages,
            extra_body=EXTRA_BODY
        )
    except openai.APIConnectionError as e:
        print(f'couldnt connect aborting: {e}', file=sys.stderr)
        sys.exit(1)
    return response.choices[0].message


def embed(text: str, model: str) -> list[float]:  
    client = openai.OpenAI(base_url=JRNL_BASE_URL, api_key=JRNL_API_KEY)
    try:
        response = client.embeddings.create(model=model, input=text)
    except openai.APIConnectionError as e:
        print(f'couldnt connect aborting: {e}', file=sys.stderr)
        sys.exit(1)
    return response.data[0].embedding


def write_json_atomic(path: Path, data) -> None:
    fd, tmp = tempfile.mkstemp(dir=JRNL_FOLDER, prefix='.tmp-', suffix='.json')
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def sync() -> None:
    with open(JRNL_FOLDER / '.sync.lock', 'w') as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print('sync already running, exiting', file=sys.stderr)
            return
        embeddings_path = JRNL_FOLDER / 'embeddings.json'
        embeddings = {}
        if embeddings_path.exists():
            embeddings = json.loads(embeddings_path.read_text())
        
        for path in JRNL_FOLDER.glob('*.json.pending'):
            j = json.loads(path.read_text())
            entry = j['entry']
            if JRNL_DEBUG:
                print(f'[{path}]')
                print(j)
            message = llm(CHUNK_SYSTEM_PROMPT, entry, JRNL_EXTRACTION_MODEL)
            if not message.content:
                raise ValueError('llm didnt return message content')
            if JRNL_DEBUG:
                if message.reasoning_content:
                    print(message.reasoning_content)
                print(message.content)
            match = re.search(r'\[.*\]', message.content.strip(), re.DOTALL)
            if not match:
                raise ValueError(f'no json array found in llm message content: {message.content.strip()}')
            try:
                chunks = json.loads(match.group(0))
            except json.JSONDecodeError as e:
                raise ValueError(f'invalid json parsed: {match.group(0)!r}') from e
            out = {
                'entry': entry,
                'chunks': []
            }
            next_id = max((int(k) for k in embeddings), default=-1) + 1
            for chunk in chunks:
                chunk_id = str(next_id)
                next_id += 1
                embeddings[chunk_id] = embed(chunk, JRNL_EMBEDDING_MODEL)
                out['chunks'].append({
                    'id': chunk_id,
                    'chunk': chunk,
                })
            write_json_atomic(embeddings_path, embeddings)
            write_json_atomic(path.with_suffix(''), out)
            path.unlink()


def ls(days: int) -> None:
    now = datetime.datetime.now()
    end = now - datetime.timedelta(days=days)
    entries = []
    for path in JRNL_FOLDER.glob('*.json*'):
        if path.stem == 'embeddings':
            continue
        if path.name == '.sync.lock':
            continue
        pending = path.name.endswith('.pending')
        name = path.name.removesuffix('.pending').removesuffix('.json')
        dt = datetime.datetime.strptime(name, '%d-%m-%Y--%H-%M-%S')
        if end <= dt <= now:
            with open(path) as f:
                data = json.load(f)
            entries.append((dt, data['entry'], pending, data.get('chunks')))
    if not entries:
        print('no entries found')
        return
    entries.sort(key=lambda e: e[0], reverse=True)
    for dt, entry, pending, chunks in entries:
        heading = f"[{dt.strftime('%d-%m-%Y %H:%M:%S')}]"
        if pending:
            heading += ' (pending)'
        print(heading)
        print(entry)
        if JRNL_DEBUG and chunks:
            for c in chunks:
                print(f"  [{c['id']}] {c['chunk']}")


def main():
    parser = argparse.ArgumentParser(prog='jrnl')
    sub = parser.add_subparsers(dest='command', title='commands')
    _ = parser.add_argument('--debug', action='store_true', help='enable debug output')

    add_parser = sub.add_parser('add', help='add jrnl entry')
    _ = add_parser.add_argument('entry', help='your jrnl entry')

    sync_parser = sub.add_parser('sync', help='sync jrnl entries')

    ls_parser = sub.add_parser('ls', help='list entries')
    _ = ls_parser.add_argument('--days', type=int, default=3, help='entries from the last n days')

    args = parser.parse_args()

    JRNL_FOLDER.mkdir(parents=True, exist_ok=True)

    if args.debug:
        global JRNL_DEBUG
        JRNL_DEBUG = True

    if args.command == 'add':
        add(args.entry)
        script = Path(__file__).resolve()
        cmd = [sys.executable, str(script)]
        if args.debug:
            cmd.append('--debug')
        cmd.append('sync')
        subprocess.Popen(cmd, 
                        stdin=subprocess.DEVNULL, 
                        stdout=subprocess.DEVNULL, 
                        stderr=subprocess.DEVNULL, 
                        start_new_session=True)

    if args.command == 'sync':
        sync()

    if args.command == 'ls':
        ls(args.days)


if __name__ == '__main__':
    main()
