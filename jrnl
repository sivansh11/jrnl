_client: openai.OpenAI | None = None
_embedding_client: openai.OpenAI | None = None


def get_client() -> openai.OpenAI:
    global _client
    if _client is None:
        _client = openai.OpenAI(base_url=JRNL_BASE_URL, api_key=JRNL_API_KEY)
    return _client


def get_embedding_client() -> openai.OpenAI:
    global _embedding_client
    if _embedding_client is None:
        _embedding_client = openai.OpenAI(base_url=JRNL_EMBEDDING_BASE_URL, api_key=JRNL_EMBEDDING_API_KEY)
    return _embedding_client


def get_extra_body() -> dict:
    raw = os.environ.get('JRNL_EXTRA_BODY', '')
    if raw:
        try:
            return json.loads(raw)
        except json.JSONDecodeError as e:
            print(f'invalid JRNL_EXTRA_BODY json: {e}', file=sys.stderr)
            sys.exit(1)
    return EXTRA_BODY


def add(entry: str) -> None:
    j = {'entry': entry}
    base = datetime.datetime.now().strftime('%d-%m-%Y--%H-%M-%S')
    name = f'{base}.json.pending'
    n = 1
    while (JRNL_FOLDER / name).exists():
        name = f'{base}-{n}.json.pending'
        n += 1
    write_json_atomic(JRNL_FOLDER / name, j)
    if JRNL_DEBUG:
        print(f'[{name}]')
        print(j)


def paint(text: str, color: str) -> str:
    codes = {'white': 37, 'gray': 90}
    return f'\x1b[{codes[color]}m{text}\x1b[0m'


def llm(messages: list[openai.ChatCompletionMessageParam], model: str, tools: list | None = None) -> tuple[str, list | None]:
    kwargs = {}
    if tools:
        kwargs['tools'] = tools
    try:
        response = get_client().chat.completions.create(
            model=model,
            messages=messages,
            extra_body=get_extra_body(),
            stream=JRNL_DEBUG,
            **kwargs,
        )
    except openai.APIConnectionError as e:
        print(f'couldnt connect aborting: {e}', file=sys.stderr)
        sys.exit(1)
    if not JRNL_DEBUG:
        message = response.choices[0].message
        tool_calls = getattr(message, 'tool_calls', None)
        if tool_calls:
            calls = [
                {'id': c.id, 'type': 'function', 'function': {'name': c.function.name, 'arguments': c.function.arguments}}
                for c in tool_calls
            ]
        else:
            calls = None
        return message.content or '', calls
    content = []
    tool_calls = []
    is_reasoning = True
    for chunk in response:
        delta = chunk.choices[0].delta
        r = getattr(delta, 'reasoning_content', None)
        if not r:
            r = getattr(delta, 'reasoning', None)
        if r:
            is_reasoning = True
            print(paint(r, 'gray'), end='', flush=True)
        c = getattr(delta, 'content', None)
        if c:
            if is_reasoning:
                is_reasoning = False
                print()
            content.append(c)
            print(paint(c, 'white'), end='', flush=True)
        tc = getattr(delta, 'tool_calls', None)
        if tc:
            for t in tc:
                idx = getattr(t, 'index', 0)
                while len(tool_calls) <= idx:
                    tool_calls.append({'id': '', 'type': 'function', 'function': {'name': '', 'arguments': ''}})
                call = tool_calls[idx]
                if t.id:
                    call['id'] += t.id
                if t.function:
                    if t.function.name:
                        call['function']['name'] += t.function.name
                    if t.function.arguments:
                        call['function']['arguments'] += t.function.arguments
    print()
    if tool_calls:
        for call in tool_calls:
            print(f"{call['function']['name']}({call['function']['arguments']})")
        return ''.join(content), tool_calls
    return ''.join(content), None


def embed(text: str, model: str) -> list[float]:
    try:
        response = get_embedding_client().embeddings.create(model=model, input=text)
    except openai.APIConnectionError as e:
        print(f'couldnt connect aborting: {e}', file=sys.stderr)
        sys.exit(1)
    return response.data[0].embedding


def write_json_atomic(path: Path, data: object) -> None:
    fd, tmp = tempfile.mkstemp(dir=JRNL_FOLDER, prefix='.tmp-', suffix='.json')
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(data, f, indent=2)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_embedding_config() -> tuple[str, int] | None:
    if not CONFIG_PATH.exists():
        return None
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return data['embeddings_model'], data['embeddings_dim']
    except (json.JSONDecodeError, KeyError, TypeError) as e:
        print(f'invalid embeddings config: {e}', file=sys.stderr)
        sys.exit(1)


def save_embedding_config(model: str, dim: int) -> None:
    write_json_atomic(CONFIG_PATH, {'embeddings_model': model, 'embeddings_dim': dim})


def extract_chunks(content: str) -> list[str]:
    text = re.sub(r'^```(?:json)?\s*|\s*```$', '', content.strip())
    match = re.search(r'\[.*\]', text, re.DOTALL)
    if not match:
        raise ValueError(f'no json array found in llm message content: {text}')
    try:
        chunks = json.loads(match.group(0))
    except json.JSONDecodeError as e:
        raise ValueError(f'invalid json parsed: {match.group(0)!r}') from e
    if not isinstance(chunks, list) or not all(isinstance(c, str) for c in chunks):
        raise ValueError(f'expected a list of strings, got: {match.group(0)!r}')
    return chunks


def sync_entry(path: Path, embeddings: dict[str, list[float]]) -> None:
    j = json.loads(path.read_text())
    entry = j['entry']
    if JRNL_DEBUG:
        print(f'[{path.name}]')
        print(j)
    content, _ = llm(
        [
            {'role': 'system', 'content': CHUNK_SYSTEM_PROMPT},
            {'role': 'user', 'content': entry},
        ],
        JRNL_EXTRACTION_MODEL,
    )
    if not content:
        raise ValueError('llm didnt return message content')
    chunks = extract_chunks(content)
    out = {'entry': entry, 'chunks': []}
    next_id = max((int(k) for k in embeddings), default=-1) + 1
    for chunk in chunks:
        chunk_id = str(next_id)
        next_id += 1
        embeddings[chunk_id] = embed(f"search_document: {chunk}", JRNL_EMBEDDING_MODEL)
        out['chunks'].append({'id': chunk_id, 'chunk': chunk})
    write_json_atomic(JRNL_FOLDER / 'embeddings.json', embeddings)
    if embeddings:
        save_embedding_config(JRNL_EMBEDDING_MODEL, len(next(iter(embeddings.values()))))
    write_json_atomic(path.with_suffix(''), out)
    path.unlink()


def sync() -> None:
    with open(JRNL_FOLDER / '.sync.lock', 'w') as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print('sync already running, exiting', file=sys.stderr)
            return

        embeddings_path = JRNL_FOLDER / 'embeddings.json'
        embeddings = {}
        if embeddings_path.exists():
            embeddings = json.loads(embeddings_path.read_text())
        config = load_embedding_config()
        if config is not None:
            stored_model, _ = config
            if stored_model != JRNL_EMBEDDING_MODEL:
                print(f'embeddings model changed from {stored_model} to {JRNL_EMBEDDING_MODEL}; run jrnl reembed', file=sys.stderr)
                sys.exit(1)
        elif embeddings:
            print('no embeddings config found; run jrnl reembed', file=sys.stderr)
            sys.exit(1)

        pending = sorted(JRNL_FOLDER.glob('*.json.pending'))
        for path in pending:
            try:
                sync_entry(path, embeddings)
            except Exception as e:
                print(f'[sync] failed {path.name}: {e}', file=sys.stderr)
            else:
                print(f'[sync] done {path.name}')


def reembed() -> None:
    with open(JRNL_FOLDER / '.sync.lock', 'w') as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print('sync already running, exiting', file=sys.stderr)
            return

        embeddings = {}
        count = 0
        for path in sorted(JRNL_FOLDER.glob('*.json')):
            if path.name.startswith('.'):
                continue
            data = json.loads(path.read_text())
            for c in data.get('chunks', []):
                embeddings[c['id']] = embed(f"search_document: {c['chunk']}", JRNL_EMBEDDING_MODEL)
                count += 1
            if JRNL_DEBUG:
                print(f'[reembed] {path.name}')
        write_json_atomic(JRNL_FOLDER / 'embeddings.json', embeddings)
        if embeddings:
            save_embedding_config(JRNL_EMBEDDING_MODEL, len(next(iter(embeddings.values()))))
        print(f'[reembed] done {count} chunks')


def ls(days: int) -> None:
    now = datetime.datetime.now()
    end = now - datetime.timedelta(days=days)
    entries = []
    for path in JRNL_FOLDER.glob('*.json*'):
        if path.name.startswith('.'):
            continue
        pending = path.name.endswith('.pending')
        name = path.name.removesuffix('.pending').removesuffix('.json')
        match = TIMESTAMP_RE.match(name)
        if not match:
            continue
        dt = datetime.datetime.strptime(match.group(1), '%d-%m-%Y--%H-%M-%S')
        if end <= dt <= now:
            with open(path) as f:
                data = json.load(f)
            entries.append((dt, data['entry'], pending, data.get('chunks')))
    if not entries:
        print('no entries found')
        return
    entries.sort(key=lambda e: e[0], reverse=True)
    for dt, entry, pending, chunks in entries:
        heading = f"[{dt.strftime('%d-%m-%Y %H:%M:%S')}]"
        if pending:
            heading += ' (pending)'
        print(heading)
        print(entry)
        if JRNL_DEBUG and chunks:
            for c in chunks:
                print(f"  [{c['id']}] {c['chunk']}")


def cosine_similarity(a: list[float], b: list[float]) -> float:
    dot = sum(x * y for x, y in zip(a, b))
    mag_a = sum(x * x for x in a) ** 0.5
    mag_b = sum(y * y for y in b) ** 0.5
    if mag_a == 0 or mag_b == 0:
        return 0.0
    return dot / (mag_a * mag_b)


def search_chunks(query: str, threshold: float, top: int, from_date: str | None = None, to_date: str | None = None) -> list[tuple[float, str, str, str]]:
    embeddings_path = JRNL_FOLDER / 'embeddings.json'
    if not embeddings_path.exists():
        raise ValueError('no embeddings found')
    embeddings = json.loads(embeddings_path.read_text())
    config = load_embedding_config()
    if config is None:
        raise ValueError('no embeddings config found; run jrnl reembed')
    stored_model, stored_dim = config
    if stored_model != JRNL_EMBEDDING_MODEL:
        raise ValueError(f'embeddings model changed from {stored_model} to {JRNL_EMBEDDING_MODEL}; run jrnl reembed')
    query_embedding = embed(f"search_query: {query}", JRNL_EMBEDDING_MODEL)
    if len(query_embedding) != stored_dim:
        raise ValueError(f'embedding dimension changed from {stored_dim} to {len(query_embedding)}; run jrnl reembed')
    start = end = None
    if from_date is not None or to_date is not None:
        start, end = parse_date_range(from_date or to_date, to_date or from_date)
    candidates = []
    for path in JRNL_FOLDER.glob('*.json'):
        if path.name.startswith('.'):
            continue
        match = TIMESTAMP_RE.match(path.name.removesuffix('.json'))
        if not match:
            continue
        if start is not None:
            dt = datetime.datetime.strptime(match.group(1), '%d-%m-%Y--%H-%M-%S').date()
            if not (start <= dt <= end):
                continue
        data = json.loads(path.read_text())
        source = path.stem
        for c in data.get('chunks', []):
            vec = embeddings.get(c['id'])
            if vec is None:
                continue
            sim = cosine_similarity(query_embedding, vec)
            if sim >= threshold:
                candidates.append((sim, source, c['id'], c['chunk']))
    candidates.sort(key=lambda x: x[0], reverse=True)
    top_candidates = candidates[:top]
    top_candidates.sort(
        key=lambda x: (
            datetime.datetime.strptime(TIMESTAMP_RE.match(x[1]).group(1), '%d-%m-%Y--%H-%M-%S'),
            int(x[2]),
        )
    )
    return top_candidates


def parse_date_range(from_date: str, to_date: str) -> tuple[datetime.date, datetime.date]:
    try:
        start = datetime.datetime.strptime(from_date, '%d-%m-%Y').date()
        end = datetime.datetime.strptime(to_date, '%d-%m-%Y').date()
    except ValueError as e:
        raise ValueError(f'invalid date (expected DD-MM-YYYY): {e}') from e
    if start > end:
        raise ValueError(f'from_date {from_date} is after to_date {to_date}')
    if JRNL_DEBUG:
        print(f'[range] {start.strftime("%d-%m-%Y")} to {end.strftime("%d-%m-%Y")}')
    return start, end


def get_entry(timestamp: str) -> dict:
    try:
        datetime.datetime.strptime(timestamp, '%d-%m-%Y--%H-%M-%S')
    except ValueError as e:
        raise ValueError(f'invalid timestamp (expected DD-MM-YYYY--HH-MM-SS): {timestamp}') from e
    for path in JRNL_FOLDER.glob('*.json*'):
        if path.name.startswith('.'):
            continue
        name = path.name.removesuffix('.pending').removesuffix('.json')
        match = TIMESTAMP_RE.match(name)
        if match and match.group(1) == timestamp:
            data = json.loads(path.read_text())
            return {
                'timestamp': timestamp,
                'entry': data['entry'],
                'chunks': [{'id': c['id'], 'chunk': c['chunk']} for c in data.get('chunks', [])],
            }
    raise ValueError(f'no entry with timestamp {timestamp}; use journal_list_entries to list entries')


def list_entries(from_date: str, to_date: str) -> list[str]:
    start, end = parse_date_range(from_date, to_date)
    entries = []
    for path in JRNL_FOLDER.glob('*.json*'):
        if path.name.startswith('.'):
            continue
        pending = path.name.endswith('.pending')
        name = path.name.removesuffix('.pending').removesuffix('.json')
        match = TIMESTAMP_RE.match(name)
        if not match:
            continue
        dt = datetime.datetime.strptime(match.group(1), '%d-%m-%Y--%H-%M-%S')
        if not (start <= dt.date() <= end):
            continue
        entries.append((dt, match.group(1), pending))
    entries.sort(key=lambda x: x[0])
    return [f'[{ts}]' if not pending else f'[{ts}] (pending)' for _, ts, pending in entries]


def dispatch_tool(name: str, args: dict) -> list[str] | dict:
    if name == 'journal_search':
        try:
            results = search_chunks(
                args.get('query', ''),
                args.get('threshold', 0.4),
                args.get('top', 5),
                args.get('from_date'),
                args.get('to_date'),
            )
        except ValueError as e:
            return {'error': str(e)}
        return [f'[{source} #{chunk_id}] {chunk}' for sim, source, chunk_id, chunk in results]
    if name == 'journal_get_entry':
        try:
            return get_entry(args.get('timestamp', ''))
        except ValueError as e:
            return {'error': str(e)}
    if name == 'journal_list_entries':
        try:
            return list_entries(args.get('from_date', ''), args.get('to_date', ''))
        except ValueError as e:
            return {'error': str(e)}
    return {'error': f'unknown tool: {name}'}


def ask(query: str, threshold: float, top: int, use_tools: bool = True) -> None:
    if not use_tools:
        try:
            top_candidates = search_chunks(query, threshold, top)
        except ValueError as e:
            print(e, file=sys.stderr)
            return
        if not top_candidates:
            print('no relevant chunks found')
            return
        context = '\n\n'.join(
            f"[{source} #{chunk_id}] {chunk}"
            for sim, source, chunk_id, chunk in top_candidates
        )
        prompt = f"Current time: {datetime.datetime.now().strftime('%d-%m-%Y--%H-%M-%S')}\nQuestion: {query}\n\nJournal context:\n{context}"
        if JRNL_DEBUG:
            print(paint(prompt, 'white'))
        content, _ = llm(
            [
                {'role': 'system', 'content': CHAT_SYSTEM_PROMPT},
                {'role': 'user', 'content': prompt},
            ],
            JRNL_CHAT_MODEL,
        )
        # in debug the content is streamed and already printed above
        if not JRNL_DEBUG and content:
            print(content)
        return

    user_prompt = f"Current time: {datetime.datetime.now().strftime('%d-%m-%Y--%H-%M-%S')}\nQuestion: {query}"
    messages: list[openai.ChatCompletionMessageParam] = [
        {'role': 'system', 'content': CHAT_TOOLS_SYSTEM_PROMPT},
        {'role': 'user', 'content': user_prompt},
    ]
    if JRNL_DEBUG:
        print(paint(user_prompt, 'white'))
    for _ in range(MAX_TOOL_ITERS):
        content, tool_calls = llm(messages, JRNL_CHAT_MODEL, tools=TOOLS)
        if tool_calls:
            messages.append(
                {
                    'role': 'assistant',
                    'content': content or None,
                    'tool_calls': tool_calls,
                }
            )
            for call in tool_calls:
                try:
                    args = json.loads(call['function']['arguments'])
                    result = dispatch_tool(call['function']['name'], args)
                except json.JSONDecodeError as e:
                    result = {'error': f'invalid tool arguments json: {e}'}
                if JRNL_DEBUG:
                    print(json.dumps(result, indent=2))
                messages.append({'role': 'tool', 'tool_call_id': call['id'], 'content': json.dumps(result)})
            continue
        # in debug the content is streamed and already printed above
        if not JRNL_DEBUG and content:
            print(content)
        return
    print('reached max tool iterations, stopping', file=sys.stderr)


def edit_entry() -> None:
    editor = os.environ.get('EDITOR')
    if not editor:
        print('please set the $EDITOR environment variable, or use `jrnl add` directly', file=sys.stderr)
        sys.exit(1)
    fd, tmp = tempfile.mkstemp(prefix='jrnl-', suffix='.md')
    try:
        with os.fdopen(fd, 'w'):
            pass
        result = subprocess.run(f'{editor} {tmp}', shell=True)
        if result.returncode != 0:
            print(f'editor exited with status {result.returncode}', file=sys.stderr)
            sys.exit(result.returncode)
        entry = Path(tmp).read_text()
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    if not entry.strip():
        print('empty entry, not saved', file=sys.stderr)
        return
    add(entry.strip())


def main():
    parser = argparse.ArgumentParser(prog='jrnl')
    sub = parser.add_subparsers(dest='command', title='commands')
    _ = parser.add_argument('--debug', action='store_true', help='enable debug output')

    add_parser = sub.add_parser('add', help='add jrnl entry')
    _ = add_parser.add_argument('entry', help='your jrnl entry')

    sync_parser = sub.add_parser('sync', help='sync jrnl entries')

    ls_parser = sub.add_parser('ls', help='list entries')
    _ = ls_parser.add_argument('--days', type=int, default=3, help='entries from the last n days')

    ask_parser = sub.add_parser('ask', help='ask a question against your journal')
    _ = ask_parser.add_argument('query', help='your question')
    _ = ask_parser.add_argument('--threshold', type=float, default=0.4, help='minimum similarity (default 0.4)')
    _ = ask_parser.add_argument('--top', type=int, default=5, help='top n chunks (default 5)')
    _ = ask_parser.add_argument('--no-tools', action='store_true', help='disable tool calling, use single-shot retrieval (default tools)')

    reembed_parser = sub.add_parser('reembed', help='reembed all chunks with the current embedding model')

    args = parser.parse_args()

    JRNL_FOLDER.mkdir(parents=True, exist_ok=True)

    if args.debug:
        global JRNL_DEBUG
        JRNL_DEBUG = True

    if args.command is None:
        edit_entry()

    if args.command == 'add':
        add(args.entry)

    if args.command == 'sync':
        sync()

    if args.command == 'ls':
        ls(args.days)

    if args.command == 'ask':
        ask(args.query, args.threshold, args.top, use_tools=not args.no_tools)

    if args.command == 'reembed':
        reembed()


if __name__ == '__main__':
    main()
